ACCESS_AUD=audience-do-aplicativo-access
# Optional, only if old /api/images/:id URLs depend on a different hosted origin:
LEGACY_MEDIA_ORIGIN=https://origem-anterior.example
# LEGACY_MEDIA_TOKEN is optional; configure as a server secret, never in Git.
